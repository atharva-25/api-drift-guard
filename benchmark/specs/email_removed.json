{
  "openapi": "3.1.0",
  "info": {
    "title": "user-service",
    "version": "2.0.0"
  },
  "paths": {
    "/users": {
      "get": {
        "summary": "List Users",
        "operationId": "list_users_users_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/User"
                  },
                  "type": "array",
                  "title": "Response List Users Users Get"
                }
              }
            }
          }
        }
      }
    },
